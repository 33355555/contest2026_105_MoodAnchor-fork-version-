{
  "name": "moodanchor-coze-demo",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": {
    "DEMO_ENABLED": "false"
  },
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "2026105",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": { "enabled": false }
}
